BENMO_ENVIRONMENT=local
BENMO_DATABASE_URL=postgresql+asyncpg://benmo:benmo@postgres:5432/benmo
# Alternative for ECS Secrets injection: omit DATABASE_URL and set the following.
# BENMO_DATABASE_HOST=postgres
# BENMO_DATABASE_PORT=5432
# BENMO_DATABASE_NAME=benmo
# BENMO_DATABASE_USER=benmo
# BENMO_DATABASE_PASSWORD=secret-injected-by-ecs
BENMO_QUEUE_BACKEND=database
BENMO_AWS_REGION=us-east-1
BENMO_SQS_ANALYSIS_QUEUE_URL=
BENMO_ADMIN_API_KEY=change-me
BENMO_BACKEND_INTERNAL_TOKEN=change-worker-token
BENMO_CORS_ORIGINS=["http://localhost:3000"]
BENMO_LOG_LEVEL=INFO
BENMO_AUTO_CREATE_SCHEMA=false
