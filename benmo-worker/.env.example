BENMO_ENV=local
BENMO_PROVIDER_MODE=stub
BENMO_LOG_LEVEL=INFO
BENMO_LOG_JSON=true

BENMO_BACKEND_BASE_URL=http://backend:8000
BENMO_BACKEND_INTERNAL_TOKEN=replace-me

BENMO_OBJECT_STORE=local
BENMO_LOCAL_OBJECT_PATH=.benmo/objects
BENMO_LOCAL_STATE_PATH=.benmo/worker-state.sqlite3
# BENMO_OBJECT_STORE=s3
# BENMO_S3_BUCKET=benmo-artifacts
BENMO_S3_PREFIX=worker
AWS_REGION=us-east-1

# research consumes analysis-requested
BENMO_RESEARCH_QUEUE_URL=
# document consumes source-fetch and filing-processing
BENMO_DOCUMENT_QUEUE_URLS=
# verification consumes indicator-verification
BENMO_VERIFICATION_QUEUE_URL=
BENMO_MANUAL_REVIEW_QUEUE_URL=
BENMO_SQS_WAIT_SECONDS=20
BENMO_SQS_VISIBILITY_TIMEOUT=900

OPENAI_API_KEY=
BENMO_OPENAI_MODEL=gpt-5.6
BENMO_OPENAI_ENTAILMENT_MODEL=gpt-5.6
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
BEA_API_KEY=
BENMO_SEC_USER_AGENT=Benmo Research ops@example.com

# Step Functions may inject these while keeping ECS command fixed.
BENMO_STAGE_INPUT=
BENMO_STAGE_OUTPUT=
