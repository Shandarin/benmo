{
  "name": "@benmo/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for the Benmo causal hypothesis platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "synth": "cdk synth",
    "diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.0",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "aws-cdk": "2.1132.0",
    "ts-node": "10.9.2",
    "typescript": "~5.9.3"
  }
}

