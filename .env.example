# Benmo 本地运行与供应商采购配置。
# 复制为 .env 后填写；不要提交真实密钥。

# ---- 应用基础配置 ---------------------------------------------------------
BENMO_ENVIRONMENT=local
BENMO_ENV=local
BENMO_LOG_LEVEL=INFO
BENMO_PROVIDER_MODE=stub
BENMO_ADMIN_API_KEY=
BENMO_BACKEND_INTERNAL_TOKEN=
BENMO_CORS_ORIGINS=["http://localhost:3000"]
BENMO_DATABASE_URL=postgresql+asyncpg://benmo:benmo@postgres:5432/benmo
BENMO_BACKEND_BASE_URL=http://backend:8000
BENMO_API_BASE_URL=http://backend:8000
SITE_URL=http://localhost:3000

# ---- AWS / LocalStack -----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
BENMO_SQS_ENDPOINT_URL=http://localstack:4566
BENMO_S3_BUCKET=benmo-local-artifacts
BENMO_S3_PREFIX=benmo
BENMO_OBJECT_STORE=s3
BENMO_LOCAL_OBJECT_PATH=/data/objects

# ---- LLM ------------------------------------------------------------------
OPENAI_API_KEY=
BENMO_OPENAI_MODEL=gpt-5.6

# ---- 新闻与行情 -----------------------------------------------------------
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ---- 官方经济数据 ---------------------------------------------------------
EIA_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# SEC 要求可联系的 User-Agent，例如：Benmo/0.1 ops@example.com
BENMO_SEC_USER_AGENT=
